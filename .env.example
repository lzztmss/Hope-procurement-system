# 心连心智能养老业务运营系统重构测试版环境变量

# PostgreSQL 连接。正式部署时数据库只允许本机访问，不要开放公网端口。
DATABASE_URL=postgresql://xlx_ops:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/xlx_ops

# 至少 32 位随机字符串。安装脚本会自动生成，手工部署时请替换。
SESSION_SECRET=CHANGE_ME_RANDOM_64_CHARS

# 初始导入时使用。正式启用后请登录系统修改管理员密码。
INITIAL_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# 首次连接新数据库时的初始数据模式：sample（导入示例业务数据，默认）或 clean-test
# clean-test 会保留基础账号、产品、供应商和期初库存，清空全部历史业务单据和流水。
INITIAL_DATA_MODE=sample

# Node 仅监听本机，由 Nginx 负责公网 HTTPS。
HOST=127.0.0.1
PORT=8787

# 公网域名，例如 https://ops.example.com
PUBLIC_BASE_URL=https://your-domain.example.com

# 公网 HTTPS 必须为 true；本地测试可临时设为 false。
COOKIE_SECURE=true

# 登录会话有效小时数。
SESSION_HOURS=12

# PostgreSQL 连接池大小。
PG_POOL_SIZE=10
